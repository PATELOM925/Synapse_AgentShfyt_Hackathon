generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

generator client_python {
  provider             = "prisma-client-py"
  recursive_type_depth = 5
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  sessions  Session[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Session {
  id          String   @id @default(cuid())
  title       String
  date        String
  lastStudied String
  progress    Int      @default(0)
  
  // material counts
  pdfCount    Int      @default(0)
  audioCount  Int      @default(0)
  videoCount  Int      @default(0)
  imageCount  Int      @default(0)

  // generation outputs
  notes       String?   // Markdown string
  flashcards  String?   // JSON Array [{front, back}]
  quiz        String?   // JSON Array [{question, options, answer_index, explanation}]
  quest       String?   // JSON State for text-adventure
  podcast     String?   // Base64 audio string or ElevenLabs output
  visual      String?   // Mermaid DSL or JSON for visual graph
  activeModes String?   // Comma separated list of active study modes
  files       String?   // JSON array of file metadata [{name, type}]

  // progress tracking for each mode
  notesProgress       Int      @default(0) // 0-100, based on scroll position
  flashcardsProgress  Int      @default(0) // 0-100, based on cards viewed
  quizProgress        Int      @default(0) // 0-100, based on correct answers
  questProgress       Int      @default(0) // 0-100, based on quest completion
  podcastProgress     Int      @default(0) // 0-100, based on audio playback
  visualProgress      Int      @default(0) // 0-100, based on interactions
  audioProgress       Int      @default(0) // 0-100, based on audio playback

  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Student {
  id         String   @id // e.g. from clerk or gen_random_uuid
  email      String?  @unique
  name       String   @default("")
  teacherId  String?
  teacher    Teacher? @relation(fields: [teacherId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  knowledgeMaps  KnowledgeMap[]
  quizSessions   QuizSession[]
  assessments    Assessment[]
  gradeReports   GradeReport[]
  notes          StudentNote[]
  flashcards     Flashcard[]
  enrollments    Enrollment[]
  invitations    ClassroomInvitation[]
}

model Teacher {
  id          String   @id
  email       String   @unique
  name        String   @default("")
  institution String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  students    Student[]
  classrooms  Classroom[]
  syllabi     Syllabus[]
  invitations ClassroomInvitation[]
  materials   ClassroomMaterial[]
}

model KnowledgeMap {
  id             String   @id @default(uuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topics         String   @default("[]") // stored as JSON string
  overallMastery Float    @default(0.0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model QuizSession {
  id          String   @id @default(uuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topics      String   @default("[]") // Stringified JSON array of topics
  quiz        String   // Stringified JSON
  createdAt   DateTime @default(now())
}

model Assessment {
  id          String   @id
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic       String
  questions   String   @default("[]") // Stringified JSON
  createdAt   DateTime @default(now())

  gradeReports GradeReport[]
}

model GradeReport {
  id            String     @id @default(uuid())
  assessmentId  String
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic         String
  score         Float
  perQuestion   String     @default("[]") // JSON string
  updatedStatus String     // JSON string
  createdAt     DateTime   @default(now())
}

model StudentNote {
  id           String   @id @default(uuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic        String
  summary      String   @default("")
  sections     String   @default("[]") // JSON string
  keyConcepts  String   @default("[]") // stringified array
  sources      String   @default("[]") // JSON string
  createdAt    DateTime @default(now())
}

model Flashcard {
  id         String   @id @default(uuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topic      String
  cards      String   @default("[]") // JSON string
  createdAt  DateTime @default(now())
}

model Classroom {
  id          String   @id @default(uuid())
  teacherId   String
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  topics      String   @default("[]") // JSON string
  joinCode    String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments   Enrollment[]
  syllabi       Syllabus[]
  snapshots     CohortSnapshot[]
  invitations   ClassroomInvitation[]
  materials     ClassroomMaterial[]
}

model Enrollment {
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrolledAt  DateTime  @default(now())

  @@id([classroomId, studentId])
}

model Syllabus {
  id          String    @id @default(uuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  topics      String    @default("[]") // JSON string
  description String    @default("")
  createdAt   DateTime  @default(now())
}

model CohortSnapshot {
  id               String    @id @default(uuid())
  classroomId      String
  classroom        Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  totalStudents    Int       @default(0)
  avgMastery       Float     @default(0.0)
  topicBreakdown   String    @default("[]") // JSON string
  strugglingTopics String    @default("[]") // JSON string
  createdAt        DateTime  @default(now())
}

model ClassroomInvitation {
  id          String    @id @default(uuid())
  code        String    @unique
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  status      String    @default("pending") // pending, accepted, revoked
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?
  expiresAt   DateTime

  @@unique([classroomId, studentId])
}

model ClassroomMaterial {
  id          String    @id @default(uuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  title       String
  materialUrl String
  contentType String    @default("application/pdf")
  description String    @default("")
  createdAt   DateTime  @default(now())
}
